{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "{data/sources/**,data/skills/**,data/graph.json,web/**}",
      "excludeFiles": "{.clickhouse/**,test/**,data/state/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 8 * * *"
    }
  ]
}
