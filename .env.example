ANTHROPIC_API_KEY=
# Only needed if your key is not scoped to a workspace (Console → Settings → Workspaces → ID, starts with wrkspc_)
ANTHROPIC_WORKSPACE_ID=
# BRAIN_MODEL=claude-opus-5-5
# BRAIN_EFFORT=medium
# ANALYST_MODEL=claude-sonnet-5-5
# ANALYST_EFFORT=medium
# APPROVAL_ROWS=30000000
# CLICKHOUSE_URL=http://127.0.0.1:8123
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=
# CLICKHOUSE_DB=pulse
# COMPANY_NAME=Acme
# PORT=3000
# MCP_PERSONA=engineer
# Shared login for deployed instances (leave empty locally for no login)
APP_PASSWORD=
# Vercel Cron auth for /api/cron (any random string)
# CRON_SECRET=
# Knowledge retrieval backend: local (BM25, default) or hydradb (requires HYDRA_DB_API_KEY + npm run hydra:sync)
# KNOWLEDGE_BACKEND=local
# HYDRA_DB_API_KEY=
# HYDRA_DB_DATABASE=company_brain
# HYDRA_DB_COLLECTION=knowledge
# HYDRA_DB_MODE=fast
